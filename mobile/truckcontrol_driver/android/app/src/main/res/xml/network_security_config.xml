<?xml version="1.0" encoding="utf-8"?>
<!--
  Android network security policy (M-16).

  A release build must never send credentials, GPS traces or receipt photos
  over plain HTTP. `cleartextTrafficPermitted="false"` at the base config makes
  that a platform-enforced guarantee rather than a convention someone has to
  remember when adding the next endpoint.

  The debug-only exception exists so `flutter run` against a laptop backend
  still works; `debug-overrides` is IGNORED in a release build, so this file
  cannot weaken production even by accident.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <!-- Local proxies (mitmproxy/Charles) during development only. -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Emulator/loopback hosts, debuggable builds only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
