{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "moduleNameMapper": { "^shared$": "<rootDir>/../../../packages/shared/src/index.ts" },
  "setupFiles": ["<rootDir>/../src/common/serialization.ts", "<rootDir>/load-env.ts"],
  "testTimeout": 60000,
  "maxWorkers": 1,
  "passWithNoTests": false
}
