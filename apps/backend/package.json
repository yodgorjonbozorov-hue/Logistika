{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "TruckControl AI — NestJS API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "prisma": "dotenv -e ../../.env -- prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "test:cov": "jest --coverage"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "minio": "^8.0.3",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shared": "workspace:*",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/common/serialization.ts"
    ],
    "moduleNameMapper": {
      "^shared$": "<rootDir>/../../../packages/shared/src/index.ts",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 27,
        "lines": 33,
        "branches": 26,
        "functions": 28
      },
      "./src/modules/expenses/expenses.service.ts": {
        "statements": 90,
        "lines": 90,
        "branches": 91,
        "functions": 91
      },
      "./src/modules/trips/trips.service.ts": {
        "statements": 76,
        "lines": 77,
        "branches": 56,
        "functions": 82
      },
      "./src/modules/trips/trip-numbering.ts": {
        "statements": 100,
        "lines": 100,
        "branches": 100,
        "functions": 100
      },
      "./src/common/subscription/subscription.service.ts": {
        "statements": 100,
        "lines": 100,
        "branches": 91,
        "functions": 100
      },
      "./src/common/subscription/subscription.guard.ts": {
        "statements": 100,
        "lines": 100,
        "branches": 90,
        "functions": 100
      },
      "./src/common/interceptors/api-response.interceptor.ts": {
        "statements": 100,
        "lines": 100,
        "branches": 92,
        "functions": 100
      },
      "./src/common/odometer.ts": {
        "statements": 100,
        "lines": 100,
        "branches": 100,
        "functions": 100
      },
      "./src/modules/events/events.service.ts": {
        "statements": 97,
        "lines": 97,
        "branches": 100,
        "functions": 91
      },
      "./src/common/trip-availability.ts": {
        "statements": 100,
        "lines": 100,
        "branches": 93,
        "functions": 100
      },
      "./src/modules/ledger/ledger.service.ts": {
        "statements": 91,
        "lines": 90,
        "branches": 83,
        "functions": 91
      },
      "./src/common/idempotency/idempotency.interceptor.ts": {
        "statements": 87,
        "lines": 89,
        "branches": 70,
        "functions": 80
      }
    }
  }
}
