{
  "name": "truckcontrol",
  "version": "0.1.0",
  "private": true,
  "description": "TruckControl AI — logistika firmalari uchun SaaS boshqaruv tizimi",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter backend --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter backend test:e2e",
    "test:web-e2e": "pnpm --filter web test:e2e",
    "prepare:workspace": "pnpm --filter shared build && pnpm --filter backend exec prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "argon2",
      "sharp",
      "esbuild"
    ],
    "overrides": {
      "multer": "^2.2.0",
      "lodash": "^4.18.1",
      "qs": "^6.15.2",
      "body-parser": "^1.20.6",
      "uuid": "^11.1.1"
    }
  }
}
