# Production values — copy to `.env.production` and fill in. Never commit it.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Full instructions: docs/DEPLOY.md

# --- Domain / edge ---
SERVER_NAME=logixa.uz
CERTBOT_EMAIL=admin@logixa.uz
# app.conf.template (HTTP, first boot) → app-tls.conf.template (after certbot)
NGINX_TEMPLATE=app.conf.template
# Extra origins the browser may load from (e.g. https://s3.logixa.uz). Empty by default.
CSP_EXTRA=

# --- Web bundle (baked in at build time) ---
# Same origin: nginx proxies /api/v1 to the backend container.
VITE_API_URL=/api/v1

# --- API ---
NODE_ENV=production
API_PORT=3000
WEB_URL=https://logixa.uz
DEFAULT_TIMEZONE=Asia/Tashkent

# --- PostgreSQL (host `postgres` is the compose service) ---
POSTGRES_USER=truckcontrol
POSTGRES_PASSWORD=CHANGE-ME-long-random
POSTGRES_DB=truckcontrol
DATABASE_URL=postgresql://truckcontrol:CHANGE-ME-long-random@postgres:5432/truckcontrol?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=truckcontrol
MINIO_ROOT_PASSWORD=CHANGE-ME-long-random-minio
MINIO_BUCKET=truckcontrol
MINIO_USE_SSL=false

# --- Auth (both secrets must be at least 16 characters; use `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=CHANGE-ME-access-secret
JWT_REFRESH_SECRET=CHANGE-ME-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- First platform admin (created on start, then ignored) ---
SUPERADMIN_EMAIL=admin@logixa.uz
SUPERADMIN_PASSWORD=CHANGE-ME-at-least-12-chars
SUPERADMIN_NAME=Platform admin

# --- Backups ---
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=22

# --- AI (8-bosqich; leave empty until then) ---
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5
WHISPER_API_URL=
WHISPER_API_KEY=

# --- Telegram / SMS ---
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
