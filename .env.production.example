# TruckAI — production environment template
#
# Bu FAQAT namuna. Haqiqiy `.env.production` HECH QACHON repositoryga
# commit qilinmaydi (.gitignore uni bloklaydi) — u serverda `chmod 600`
# bilan yoki secret manager orqali beriladi.
#
# To'ldirgandan keyin MAJBURIY tekshiruv:
#
#     sh deploy/check-production-env.sh /etc/truckai/.env.production
#
# REPLACE_ME qolgan bo'lsa skript ham, API ham ko'tarilmaydi.

# --- Umumiy ---
NODE_ENV=production
API_PORT=3000

# Brauzer ochadigan manzil. CORS origin ham shu. https majburiy.
WEB_URL=https://app.REPLACE_ME_DOMAIN
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Web build (vite build vaqtida o'qiladi, runtime'da emas) ---
# Bu qiymat bundle ichiga kiradi — sir emas, faqat manzil.
VITE_API_URL=https://api.REPLACE_ME_DOMAIN/api/v1

# --- PostgreSQL ---
# Ilova foydalanuvchisi SUPERUSER bo'lmasin va CREATEDB huquqi ham kerak emas.
# Yaratish: deploy/postgres-roles.sql
DATABASE_URL=postgresql://truckai_app:REPLACE_ME_DB_PASSWORD@127.0.0.1:5432/truckai?schema=public

# Migratsiya uchun alohida, kuchliroq huquqli foydalanuvchi. Faqat CI/migration
# job ishlatadi; ilova runtime'i buni ko'rmaydi.
MIGRATION_DATABASE_URL=postgresql://truckai_migrator:REPLACE_ME_MIGRATOR_PASSWORD@127.0.0.1:5432/truckai?schema=public

# --- Reverse proxy ---
# nginx orqasida 1. To'g'ridan-to'g'ri ochilgan bo'lsa 0.
# Productionda bu qiymat ANIQ yozilishi shart — API aks holda ko'tarilmaydi.
TRUST_PROXY=1

# --- Rate limiting (global fallback; har route o'z limitiga ega) ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
MAX_UPLOAD_MB=15
MAX_JSON_BODY_MB=2

# --- Redis ---
# Loopback bo'lmasa parol MAJBURIY (API tekshiradi).
REDIS_URL=redis://127.0.0.1:6379

# --- MinIO / S3 ---
# MINIO_ENDPOINT loopback bo'lmasa MINIO_USE_SSL=true bo'lishi SHART.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=truckai_app
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_PASSWORD
MINIO_BUCKET=truckai

# --- Auth ---
# Har birini alohida generatsiya qiling, ikkitasi bir xil bo'lmasin:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI yordamchi ---
# `mock` — kalitsiz ishlaydi, javoblar deterministik va raqamlari to'g'ri.
# `anthropic` — Claude; kalitsiz bo'lsa API ko'tarilmaydi.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=15000
AI_MAX_PROMPT_CHARS=500
AI_MAX_ANSWER_CHARS=1200
AI_MAX_ANSWER_TOKENS=2048
AI_ENABLED=true

# --- Backup ---
# Backup shifrlash paroli. Bu YO'QOLSA backup'lar ochilmaydi — parolni
# alohida, boshqa joyda saqlang (backup bilan bir serverda emas).
BACKUP_PASSPHRASE=REPLACE_ME_BACKUP_PASSPHRASE
BACKUP_DIR=/var/backups/truckai
BACKUP_RETENTION_DAYS=30
# Offsite nusxa uchun `mc` alias/bucket yo'li. Bo'sh bo'lsa backup faqat shu
# serverda qoladi — ya'ni server yo'qolsa backup ham yo'qoladi.
BACKUP_S3_TARGET=

# --- SMS (haydovchi kirishi) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
