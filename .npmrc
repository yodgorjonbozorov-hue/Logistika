# Run lifecycle scripts of workspace projects (apps/backend's `postinstall`
# generates the Prisma client). Without this a clean clone typechecks and tests
# against a @prisma/client that exports nothing, which is exactly how the suite
# used to fail on a fresh checkout.
enable-pre-post-scripts=true

# Prisma's postinstall in the dependency itself also needs to be allowed.
# pnpm 9 blocks dependency build scripts unless they are listed here.
