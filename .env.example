# Nusxa oling: cp .env.example .env  (hech qachon .env ni commit qilmang)

# --- Umumiy ---
NODE_ENV=development
API_PORT=3000
WEB_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Web (Vite build vaqtida o'qiydi) ---
VITE_API_URL=http://localhost:3000/api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truckcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truckcontrol
DATABASE_URL=postgresql://truckcontrol:change-me@localhost:5432/truckcontrol?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-mos fayl saqlash) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=truckcontrol
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=truckcontrol
MINIO_USE_SSL=false

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI ---
# Bo'sh qoldirilsa ilova baribir ishlaydi: AI funksiyalari o'chadi,
# qo'lda kiritish oqimi to'liq saqlanadi (TZ §8.12, 5-qoida).
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
WHISPER_API_URL=
WHISPER_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- SMS (haydovchi kirishi uchun) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
