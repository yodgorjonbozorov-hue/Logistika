# Nusxa oling: cp .env.example .env  (hech qachon .env ni commit qilmang)

# --- Umumiy ---
NODE_ENV=development
API_PORT=3000
# Vergul bilan bir nechta origin berish mumkin (CORS ruxsati)
WEB_URL=http://localhost:5173
# Vercel preview deploy'lari uchun qo'shimcha origin oilasi (ixtiyoriy)
WEB_PREVIEW_SUFFIX=
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Web (Vite build vaqtida o'qiydi) ---
VITE_API_URL=http://localhost:3000/api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truckcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truckcontrol
DATABASE_URL=postgresql://truckcontrol:change-me@localhost:5432/truckcontrol?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-mos fayl saqlash) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=truckcontrol
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=truckcontrol
MINIO_USE_SSL=false
# Boshqariladigan S3 (R2 / AWS / Supabase) uchun kerak bo'ladi
MINIO_REGION=

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Rejalashtirilgan vazifalar (serverless deploy uchun) ---
# Vercel Cron `/api/v1/cron/*` ga shu sirni Bearer sifatida yuboradi.
# Bo'sh qoldirilsa, cron endpoint'lari yopiq turadi. Min. 16 belgi.
CRON_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5
WHISPER_API_URL=
WHISPER_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- SMS (haydovchi kirishi uchun) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
