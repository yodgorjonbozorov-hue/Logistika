# Nusxa oling: cp .env.example .env  (hech qachon .env ni commit qilmang)

# --- Umumiy ---
NODE_ENV=development
API_PORT=3000
WEB_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Web (Vite build vaqtida o'qiydi) ---
VITE_API_URL=http://localhost:3000/api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truckcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truckcontrol
DATABASE_URL=postgresql://truckcontrol:change-me@localhost:5432/truckcontrol?schema=public

# --- Reverse proxy / limits ---
# Number of trusted proxy hops (nginx = 1). Keep 0 when the API is exposed
# directly: with it on, clients can forge X-Forwarded-For and skip rate limits.
TRUST_PROXY=0
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
MAX_UPLOAD_MB=15
MAX_JSON_BODY_MB=2

# --- Platform bootstrap (prisma db seed; never commit real values) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Administrator

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-mos fayl saqlash) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=truckcontrol
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=truckcontrol
MINIO_USE_SSL=false

# --- Auth ---
# Generate real values with:  openssl rand -base64 48
# Minimum 32 characters; the API refuses to boot in production on a placeholder.
JWT_ACCESS_SECRET=replace-with-32+-random-chars-access-xxxxxxxx
JWT_REFRESH_SECRET=replace-with-32+-random-chars-refresh-xxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5
WHISPER_API_URL=
WHISPER_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- SMS (haydovchi kirishi uchun) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
