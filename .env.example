# Nusxa oling: cp .env.example .env  (hech qachon .env ni commit qilmang)

# --- Umumiy ---
NODE_ENV=development
API_PORT=3000
WEB_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Web (Vite build vaqtida o'qiydi) ---
VITE_API_URL=http://localhost:3000/api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truckcontrol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truckcontrol
DATABASE_URL=postgresql://truckcontrol:change-me@localhost:5432/truckcontrol?schema=public
# Tenant so'rovlari uchun alohida, BYPASSRLS'siz rol (RLS shu bilan kuchga kiradi).
# Production'da MAJBURIY — scripts/create-db-roles.sql va docs/DEPLOYMENT.md §9.
# Dev'da bo'sh qoldirilsa DATABASE_URL ishlatiladi va RLS amalda o'chiq bo'ladi.
DATABASE_URL_APP=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-mos fayl saqlash) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=truckcontrol
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=truckcontrol
MINIO_USE_SSL=false
# Brauzer ochadigan manzil (presigned URL shu bilan yasaladi). Docker'da ichki
# MINIO_ENDPOINT=minio bo'ladi, tashqarisi esa quyidagi manzil orqali ochadi.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5
WHISPER_API_URL=
WHISPER_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- SMS (haydovchi kirishi uchun) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# --- Seed (birinchi SUPERADMIN) ---
SEED_SUPERADMIN_EMAIL=superadmin@truckcontrol.uz
SEED_SUPERADMIN_PASSWORD=
